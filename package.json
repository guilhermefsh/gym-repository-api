{
  "name": "gympass-style-app",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test:CPE": "npm link ./prisma/vitest-environment-prisma",
    "test:IPE": "npm link vitest-environment-prisma",
    "test": "vitest run --dir src/services",
    "test:watch": "vitest --dir src/services",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "pretest:e2e": "run-s test:CPE test:IPE",
    "test:e2e": "vitest run --dir src/http",
    "test:e2e:watch": "vitest --dir src/http",
    "dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "build": "tsup src --out-dir build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@rocketseat/eslint-config": "2.2.2",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.13.1",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "3.0.6",
    "@vitest/ui": "3.0.6",
    "eslint": "8.57.1",
    "npm-run-all": "4.1.5",
    "prisma": "6.3.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.0.6"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/jwt": "9.0.4",
    "@prisma/client": "6.3.1",
    "bcryptjs": "3.0.1",
    "dayjs": "1.11.13",
    "dotenv": "16.4.7",
    "fastify": "^5.2.1",
    "supertest": "7.0.0",
    "zod": "3.24.2"
  }
}
